  "exceptions": [
    {
      "id": "personal-status-palettes",
      "rule": "Только статусы используют выбранную личную палитру. Пресеты и собственный набор проверяются отдельным сценарием; навигация и общий текст не перекрашиваются"
    },
    {
      "id": "browser-input-threshold",
      "rule": "На телефоне поле16px при основном тексте 13 px, чтобы Safari не увеличивал страницу при фокусе"
    },
    {
      "id": "approved-field-padding",
      "rule": "Поля окна 9×15 px и шаг 7 px между верхними рядами — именованные исторические роли, а не произвольные отступы новых компонентов"
    },
    {
      "id": "data-geometry",
      "rule": "Ширина графика, положение popover и перенос таблицы зависят от данных/геометрии. Они не создают новый цвет или типографическую ступень"
    }
  ],
