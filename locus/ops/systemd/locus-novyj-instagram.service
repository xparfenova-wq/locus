[Unit]
Description=Locus Instagram measurements
After=network-online.target locus-novyj.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/locus-novyj
EnvironmentFile=/etc/locus-novyj.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /var/www/locus-novyj/collector/media_collect.py --all --only instagram
TimeoutStartSec=45min
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/locus-novyj/db/sbor-ochered /var/lib/locus-novyj
